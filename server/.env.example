PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evee
JWT_ACCESS_SECRET=your_jwt_secret
JWT_ACCESS_EXPIRES_IN=1d
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Charger discovery (server-only). Enable "Places API (New)" and "Geocoding API" on this key and
# restrict it by API (and by server IP where possible). Falls back to GOOGLE_MAPS_API_KEY when empty.
GOOGLE_PLACES_API_KEY=
# 'off' drops connector data from list searches (Nearby Search Pro instead of Enterprise + Atmosphere billing).
GOOGLE_PLACES_EV_FIELDS=on
APP_ORIGIN=http://localhost:8080
BCRYPT_SALT_ROUNDS=10
BOOKING_BUFFER_MINUTES=15

# Required for production account forms. Keep these ONLY on the server.
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=www.goevee.in,goevee.in
# Vercel supplies one trusted edge hop; use 0 for a directly exposed Node server.
TRUST_PROXY_HOPS=0
