# Browser-visible values only. Never add a private credential with VITE_.
# Use a separate Google browser key restricted to goevee.in (HTTP referrers) and to the Maps JavaScript API.
# Charger search runs on the server (GOOGLE_PLACES_API_KEY); this key only draws the station map.
VITE_GOOGLE_MAPS_API_KEY=
VITE_API_BASE_URL=/api/v1
# Public GA4 measurement ID. Analytics stays off without it or without consent.
VITE_GA_MEASUREMENT_ID=
# Public Cloudflare Turnstile site key (pair with the server secret).
VITE_TURNSTILE_SITE_KEY=
